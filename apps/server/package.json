{
  "name": "@lantern/server",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "LANtern server: local REST/WebSocket API (Fastify + node:sqlite), compiles to a single binary",
  "scripts": {
    "dev": "bun --watch src/index.ts --data \"$HOME/.local/share/com.lantern.teacher/data\"",
    "start": "bun src/index.ts",
    "build": "bun build --compile src/index.ts --outfile dist/lantern-server",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "fastify": "^5.2.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
