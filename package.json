{
  "name": "@lantern/root",
  "version": "0.7.0",
  "private": true,
  "description": "LANtern: offline classroom testing system (course project)",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev:server": "pnpm --filter @lantern/server dev",
    "dev:web": "pnpm --filter @lantern/web-client dev",
    "dev:desktop": "pnpm --filter @lantern/desktop tauri dev",
    "build:server": "pnpm --filter @lantern/server build",
    "build:web": "pnpm --filter @lantern/web-client build",
    "build:desktop": "pnpm --filter @lantern/desktop build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "desktop:sidecar": "bash scripts/desktop-sidecar.sh",
    "smoke:console": "bash scripts/console-smoke.sh",
    "check:browser": "node scripts/browser-checks.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
